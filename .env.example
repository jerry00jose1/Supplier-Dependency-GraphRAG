# ---------------------------------------------------------------------------
# Supplier Dependency GraphRAG — inherited environment template
# Reuse existing LLM and ERPNext settings locally.
# Copy to .env and fill in values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Berlin

# --- ERPNext (official frappe_docker pwd.yml demo stack) ---
ERPNEXT_BASE_URL=http://localhost:8080
ERPNEXT_SITE=frontend
ERPNEXT_ADMIN_USER=Administrator
ERPNEXT_ADMIN_PASSWORD=admin
# Generated after first login / API key creation (Stage 1 discovery)
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_TIMEOUT_SECONDS=30

# --- Project state (conversations, proposals and audit records) ---
# Both Slack and the database initializer use this project's state database.
# Defaults to an absolute SQLite file in this repository; can use separate PostgreSQL DB.
# GRAPH_APP_DATABASE_URL=postgresql+psycopg://procurement:procurement@localhost:5433/supplier_graph

# --- LLM (reasoning / tool calling) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# --- Embeddings (default: local HuggingFace via fastembed — no cloud call) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Slack (Stage 6) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
# Comma-separated Slack user IDs allowed to approve ERP writes
SLACK_APPROVER_USER_IDS=
# Channel where /propose posts the approval card. Starts with C.
SLACK_CHANNEL_ID=

# --- Approval / safety ---
# Hard-coded allowlist also enforced in backend code (not by LLM prompts)
# Line total at or below this is submitted by one approval. Above it, a second approver submits.
ORDER_SUBMIT_LIMIT=5000

# --- Local Neo4j demo (make graph-up) ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=supplier-demo-local
NEO4J_DATABASE=neo4j
